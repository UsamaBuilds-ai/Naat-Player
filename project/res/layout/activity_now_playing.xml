<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/npLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NOW PLAYING"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.3" />

        <TextView
            android:id="@+id/btnFav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="♡"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnQueue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnEq"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="≋"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnTimer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="⏱"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bigArt"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_art">

        <ImageView
            android:id="@+id/bigArtImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/bigArtGlyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="♪"
            android:textColor="@color/on_accent"
            android:textSize="64sp"
            android:textStyle="bold" />
    </FrameLayout>

    <com.pulse.player.EqualizerView
        android:id="@+id/eqVisualizer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="14dp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/posText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/accent_dim"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/durText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/btnShuffle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="⇄"
            android:textColor="@color/text_dim"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="⏮"
            android:textColor="@color/accent_soft"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_play"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/on_accent"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@color/accent_soft"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/btnRepeat"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/accent"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyricsCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lyricsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LYRICS"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.28" />

            <TextView
                android:id="@+id/lyricsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/lyricsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lyricsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
