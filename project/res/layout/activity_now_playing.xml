<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/npLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="NOW PLAYING"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.3" />

            <TextView
                android:id="@+id/btnFav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Favourite"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnQueue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Queue"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Sleep timer"
                android:gravity="center"
                android:text="⏱"
                android:textColor="@color/text"
                android:textSize="17sp" />
        </LinearLayout>

        <com.pulse.player.DiscArtView
            android:id="@+id/disc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:contentDescription="Spinning Naat artwork" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/posText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/accent_dim"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/durText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btnShuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Shuffle"
                android:gravity="center"
                android:text="⇄"
                android:textColor="@color/text_dim"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Previous Naat"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/accent_soft"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="@drawable/bg_play"
                android:contentDescription="Play or pause"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/on_accent"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Next Naat"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/accent_soft"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnRepeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Repeat"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/accent"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lyricsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="⌃  Swipe up for lyrics"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Dim the player while the lyrics sheet is open. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Lyrics live in a bottom sheet, never on the front screen. -->
    <LinearLayout
        android:id="@+id/lyricsSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="110dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <View
            android:id="@+id/sheetHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lyricsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LYRICS"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.28" />

            <TextView
                android:id="@+id/lyricsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnLanguage"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="Lyrics language"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="URDU ▾"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/lyricsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lyricsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
