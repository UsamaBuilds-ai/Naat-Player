<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widgetArt"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/widget_disc"
            android:scaleType="centerCrop"
            android:contentDescription="Open Now Playing" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nothing_playing"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widgetArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/tagline"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetPrev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⏮"
            android:textSize="16sp"
            android:textColor="@color/accent_soft" />

        <TextView
            android:id="@+id/widgetPlay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_play"
            android:text="▶"
            android:textSize="17sp"
            android:textColor="@color/on_accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⏭"
            android:textSize="16sp"
            android:textColor="@color/accent_soft" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widgetProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:progressBarStyleHorizontal"
        android:max="1000"
        android:indeterminate="false" />
</LinearLayout>
