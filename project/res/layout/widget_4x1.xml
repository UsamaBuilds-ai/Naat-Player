<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:paddingLeft="8dp"
    android:paddingRight="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widgetArt"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/widget_disc"
        android:scaleType="centerCrop"
        android:contentDescription="Open Now Playing" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nothing_playing"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/tagline"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetPrev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⏮"
        android:textSize="16sp"
        android:textColor="@color/accent_soft" />

    <TextView
        android:id="@+id/widgetPlay"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:background="@drawable/bg_play"
        android:text="▶"
        android:textSize="16sp"
        android:textColor="@color/on_accent"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⏭"
        android:textSize="16sp"
        android:textColor="@color/accent_soft" />
</LinearLayout>
